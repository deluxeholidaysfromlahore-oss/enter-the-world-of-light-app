# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Required for live YouTube Data API v3 integration.
# Created in Google Cloud Console with YouTube Data API v3 restriction.
# Configured via AI Studio Secrets.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 Web Client ID for enter-the-world-web-app
GOOGLE_WEB_CLIENT_ID="886208799724-u0vmh04v159p52j5873jtvveld5labbm.apps.googleusercontent.com"

# APPS_SCRIPT_CLIENT_ID: OAuth 2.0 Apps Script Client ID for enter-the-world-web-app
APPS_SCRIPT_CLIENT_ID="886208799724-j34q9po6ms87og6ocper2fmrn4vg51k9.apps.googleusercontent.com"

